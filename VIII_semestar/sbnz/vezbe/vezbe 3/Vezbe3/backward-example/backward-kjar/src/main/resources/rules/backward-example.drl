package rules;

import com.ftn.sbnz.backward.model.models.Location;

query isContainedIn( String x, String y )
  Location( x, y; )
  or
//   ( Location( x, z; ) and isContainedIn( z, y; ) )
  ( Location( z, y; ) and isContainedIn( x, z; ) )
  // ab
  // ac cb
end

rule "go" salience 10
when
    $s : String(  )
then
    System.out.println( $s );
end


